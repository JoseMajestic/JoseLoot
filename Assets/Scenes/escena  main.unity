  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La importancia de la meora de habilidades radica en la destreza del cazador
    capaz de mantener las estadisticas por encima de un nivel \xF3ptimo.\n\nRecuerda
    que cuanto m\xE1s alto sean los valores \"BREED\" de tu cazador , mayor ser\xE1
    la\nmejora de estad\xEDsticas obtenida con los \"Upgrades\" .\n\nSi eres incapaz
    de subir los valores, directamente eres imb\xE9cil, mejor borra este juego.\nSi
    tienes dificultades para derrotar a los enemigos y avanzar en al historia, recuerda
    que Dios da sus mejores batallas a sus mejores guerreros, no obstante, eso no
    significa que vaya a ser f\xE1cil.\n\nUno de cada 10 jugadores encuentran este
    mensaje motivacional, por lo que si\xE9ntente libre de encontrar consuelo en
    estas palabras siempre que lo necesites.\n\n\"Miles Dei qui numquam se reddit
    quia benedictus est.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 07b03c471831fb5458669e24515df248, type: 2}
