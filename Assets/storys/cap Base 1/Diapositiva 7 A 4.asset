  m_Script: {fileID: 11500000, guid: e33b09a512d9ad0469e2a1f982aae868, type: 3}
  m_Name: Diapositiva 7 A 4
  m_EditorClassIdentifier: Assembly-CSharp::StoryPanelTransitionNode
  image: {fileID: 0}
  text: "Te arrastras ante Varro. Besas el polvo, no por fe, sino\n por c\xE1lculo.
    El lanista sonr\xEDe al ver tu degradaci\xF3n. \n\nTe asigna tareas sucias, castigos
    ajenos, trabajos nocturnos. \nSobrevives, pero ya no como hombre. Roma te conserva
    \nporque eres \xFAtil, no porque valgas. \n\nCada d\xEDa obedeces, cada noche
    te odias m\xE1s. \nEl cuerpo aguanta, el alma se endurece como hierro viejo."
  nodeRewardCoins: 0
  nodeRewardItems: []
  title: "La Sumisi\xF3n del Roto"
  optionAText: "Varro te vende como carne barata a un destacamento militar, iniciando
    un camino forzado hacia la guerra que a\xFAn no comprendes."
  optionANode: {fileID: 11400000, guid: 55ab1b17ae988424a9600a55e5f229fa, type: 2}
  hasOptionB: 0
  optionBText: "Opci\xF3n B"
  optionBNode: {fileID: 0}
